{
  "name": "wity-sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for the Wity typed-decision API",
  "keywords": [
    "wity",
    "typed-decisions",
    "classification",
    "decision",
    "sdk",
    "api"
  ],
  "homepage": "https://wity.alphanimble.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/info-alphanimble/wity-sdk-ts.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "WITY_LIVE=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run test/live.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "fixtures": "node --env-file-if-exists=.env scripts/capture-fixtures.mjs",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
